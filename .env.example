# Monday.com API (profile picture → Developers → API token → Show). The token acts as that user.
MONDAY_API_TOKEN=your-monday-api-token
# Optional, default 2026-10 (the current version since 1 October 2026)
MONDAY_API_VERSION=2026-10
# The number in the board URL: https://yourteam.monday.com/boards/1234567890
MONDAY_BOARD_ID=1234567890
# Optional: the group new leads go into. Empty means the board's top group.
MONDAY_GROUP_ID=
# Optional, default New. This status label must exist on the board.
MONDAY_STATUS_NEW_LABEL=New

# Column IDs (turn on Developer mode in monday.labs to see them). Required:
MONDAY_COL_EMAIL=email_mkv1a2b3
MONDAY_COL_PHONE=phone_mkv1c4d5
MONDAY_COL_STATUS=status
MONDAY_COL_OWNER=person
MONDAY_COL_MESSAGE=long_text_mkv1e6f7
# Optional columns. Leave empty to skip.
MONDAY_COL_COMPANY=text_mkv1g8h9
MONDAY_COL_SOURCE=text_mkv1j0k1
MONDAY_COL_LAST_INQUIRY=date_mkv1l2m3

# The people who take turns, in order. mondayUserId goes into the People column.
# slackWebhookUrl is optional (their own channel); without it they are mentioned in the team channel.
# "away": true takes someone out of the rotation.
OWNERS_JSON=[{"name":"Alex Rivera","mondayUserId":41000001,"slackMemberId":"U0ALEX0001"},{"name":"Sam Lee","mondayUserId":41000002,"slackMemberId":"U0SAM00001"},{"name":"Pat Kim","mondayUserId":41000003,"slackMemberId":"U0PAT00001","away":true}]

# Any long random strings. The form sends the first in the X-Webhook-Secret header,
# Run Now needs the second in the X-Run-Secret header.
LEAD_WEBHOOK_SECRET=make-up-a-long-random-string
RUN_NOW_SECRET=make-up-another-long-random-string

# Slack incoming webhook for the team channel (also used by the error alert workflow)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional: the manager's Slack member ID (mentioned in escalations) and a separate webhook for escalations
MANAGER_SLACK_ID=U0MANAGER1
MANAGER_SLACK_WEBHOOK_URL=

# Optional: hours a lead can stay New before the owner is nudged (default 2). The manager is told at twice this.
SLA_HOURS=2
# Optional: country for phone numbers typed without a country code (default US)
DEFAULT_COUNTRY=US

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
